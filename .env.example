# GRYT Club — environment variable template
#
# Copy this file to `.env.local` (gitignored) and fill in the real values:
#     cp .env.example .env.local
#
# Obtain values from the Supabase dashboard and the team secrets manager.
# NEVER commit a file containing real keys, anon JWTs, or service-role values.
#
# Two parallel sets exist:
#   • VITE_*  → inlined into the CLIENT bundle at build time (publicly visible).
#   • bare    → read from process.env on the SERVER only.

# ──────────────────────────────────────────────────────────────────────────
# Client-exposed (safe to ship to the browser — RLS-protected anon tier)
# ──────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<your-supabase-anon-publishable-key>"
VITE_SUPABASE_PROJECT_ID="<your-project-ref>"

# ──────────────────────────────────────────────────────────────────────────
# Server-side, non-secret (publishable values used by SSR & auth middleware)
# ──────────────────────────────────────────────────────────────────────────
SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<your-supabase-anon-publishable-key>"
SUPABASE_PROJECT_ID="<your-project-ref>"

# ──────────────────────────────────────────────────────────────────────────
# Private / server-only secrets — NEVER expose to the client, never VITE_-prefix.
# Set these locally in `.env.local` / `.dev.vars`, or in your deployment
# platform's secret store. Leave them unset if you are not exercising the
# admin / email code paths locally.
# ──────────────────────────────────────────────────────────────────────────

# Supabase service role key — bypasses Row Level Security, full DB access.
SUPABASE_SERVICE_ROLE_KEY="<your-supabase-service-role-key>"

# Lovable email service API key (required to send email).
LOVABLE_API_KEY="<your-lovable-api-key>"

# Optional: override the Lovable email send endpoint.
# LOVABLE_SEND_URL="https://<lovable-email-send-endpoint>"
